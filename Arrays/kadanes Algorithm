/*  
In this problem this kadanes algorithm is used to find the maximum subarray sum in this algorithm we keep add the elements 
is sum is less than zero then change the current sum value to 0 and keep on updating the max sum
*/
class Solution {
    public int maxSubArray(int[] nums) {
        int maxsum = Integer.MIN_VALUE;
        int sum =0;
        for(int i=0;i<nums.length;i++){
            sum = sum+nums[i];
            if(sum>maxsum){
                maxsum = sum;
            }
            if(sum<0){
                sum=0;
            }
        }
        return maxsum;
    }
}
